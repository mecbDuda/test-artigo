# Configuração da API alvo lida por scripts/run_one.sh.
# PROXY_PORT é a porta do proxy do slot (8080+k); sem slot, 8080.
API_NAME=catwatch

# Especificação Swagger 2.0 do WFD (openapi/catwatch.json), usada por TODAS as ferramentas
SCHEMA_FILE=apis/catwatch/openapi.json

# basePath "/"
BASE_URL=http://localhost:${PROXY_PORT:-8080}

HEALTH_URL=http://localhost:${PROXY_PORT:-8080}/config

# Banco H2 em memória: recriar o contêiner já restaura o estado inicial
INIT_CMD="true"

# Sem autenticação
AUTH_SCRIPT=
