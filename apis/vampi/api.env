# Configuração da API alvo lida por scripts/run_campaigns.sh
API_NAME=vampi

# Especificação OpenAPI usada por TODAS as ferramentas (mesmo arquivo para todas).
# Baixe de https://github.com/erev0s/VAmPI/tree/master/openapi_specs e salve aqui:
SCHEMA_FILE=apis/vampi/openapi3.yml

# A API é acessada pelo proxy de captura
BASE_URL=http://localhost:8080

# URL usada para saber se a API subiu
HEALTH_URL=http://localhost:8080/

# Comando executado após subir a API para restaurar o estado inicial (popula o banco)
INIT_CMD="curl -fsS http://localhost:8080/createdb"

# Script que imprime UMA linha no formato "Authorization: Bearer <token>"
AUTH_SCRIPT=apis/vampi/get_token.sh
