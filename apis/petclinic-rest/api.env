# Configuração da API alvo lida por scripts/run_one.sh.
# PROXY_PORT é a porta do proxy do slot (8080+k); sem slot, 8080.
API_NAME=petclinic-rest

# Especificação OpenAPI 3.1 do WFD (openapi/petclinic-rest.json), usada por TODAS as ferramentas
SCHEMA_FILE=apis/petclinic-rest/openapi.json

# A especificação declara o servidor http://localhost:8080/petclinic; aqui vale a porta do slot
BASE_URL=http://localhost:${PROXY_PORT:-8080}/petclinic

HEALTH_URL=http://localhost:${PROXY_PORT:-8080}/petclinic/api/pettypes

# Banco H2 em memória: recriar o contêiner já restaura o estado inicial
INIT_CMD="true"

# Sem autenticação
AUTH_SCRIPT=
