# Parâmetros do experimento (registre os valores finais no artigo)
TOOLS="schemathesis restler evomaster"
APIS="vampi petclinic-rest catwatch"
REPS=3                  # mínimo 3; 5 ou mais se houver tempo
BUDGET_MIN=30           # orçamento por campanha, em minutos (30 ou 60)
BASE_SEED=1000

# Versões das ferramentas (Quadro 3 do artigo; detalhes em docs/versoes.md)
# Formato tag@digest: o Docker usa o digest, a tag fica só como referência legível.
ST_VERSION=4.34.0@sha256:7aa27b2085e944c81f5225c52c29bf072778bb5d59e6b27e1876b4757e266a14
# RESTler: v8.5.0 (planejada) quebrava no modo fuzz; trocada pela v9.2.4 (docs/desvios.md, D11)
RESTLER_IMAGE=mcr.microsoft.com/restlerfuzzer/restler:v9.2.4@sha256:f37705fc4a11071f1de67ac4708fd97c71c1b4e5a0bc0f9c16c21028c0c41cbb
EM_VERSION=v5.1.0@sha256:cf02675504a0b51c268c9320e7d6f7fce92e038c62d5a0bdb25e175ea86c0c89
# Imagens das APIs e do proxy: fixadas por digest em apis/<api>/docker-compose.yml
