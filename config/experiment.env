# Parâmetros do experimento (registre os valores finais no artigo)
TOOLS="schemathesis restler evomaster"
APIS="vampi"            # acrescente as demais APIs, separadas por espaço
REPS=3                  # mínimo 3; 5 ou mais se houver tempo
BUDGET_MIN=30           # orçamento por campanha, em minutos (30 ou 60)
BASE_SEED=1000

# Versões das ferramentas (fixe e registre no Quadro 3 do artigo)
ST_VERSION=stable       # troque por uma versão exata, ex.: 4.x.y
RESTLER_IMAGE=mcr.microsoft.com/restlerfuzzer/restler:v8.5.0
EM_VERSION=v5.1.0
